# Piano Suite environment template
#
# Copy to .env.local and fill in real values:
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real keys.

# --- Clerk (authentication) ------------------------------------------------
# Dashboard: https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
# Convex validates Clerk JWTs against this domain, so the same value must also
# be set on each Convex deployment (dev, production, and preview defaults).
CLERK_FRONTEND_API_URL=https://your-app.clerk.accounts.dev

# Optional Clerk redirect overrides. Useful on hosted deploys; safe to omit locally.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Convex (database) -----------------------------------------------------
# Printed by `npx convex dev` on first run. On Vercel this is injected at build
# time by `npx convex deploy --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL`.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- AI chat (/chat) -------------------------------------------------------
# Console: https://www.kimi.com/code/console
KIMI_CODE_API_KEY=replace_me
KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1
KIMI_CODE_MODEL=replace_me

# The single Clerk user id allowed to use /api/chat. Find it in the Clerk
# Dashboard under Users. Everyone else gets 403.
ALLOWED_CLERK_USER_ID=user_replace_me

# --- Anki (optional) -------------------------------------------------------
# AnkiConnect endpoint. Defaults to http://127.0.0.1:8765 when unset.
# All Anki features degrade gracefully when AnkiConnect is not running.
# NEXT_PUBLIC_ANKI_CONNECT_URL=http://127.0.0.1:8765

# --- Auth bypass (opt-in escape hatch) -------------------------------------
# "true" opens EVERY route without signing in and skips the /api/chat
# allowlist. Only the exact string "true" enables it. Because this is a
# NEXT_PUBLIC_* value it is baked in at build time: restart `npm run dev`
# (or redeploy) after changing it. Leave unset for normal development.
# NEXT_PUBLIC_AUTH_DISABLED=true

# --- Playwright E2E --------------------------------------------------------
# Deterministic test user created during global setup. The +clerk_test suffix
# suppresses real email delivery. Password must be at least 8 characters.
E2E_CLERK_USER_EMAIL=e2e-piano-suite+clerk_test@example.com
E2E_CLERK_USER_PASSWORD=replace_me_min_8_chars

# Escape hatch for the e2e guard that fails fast when NEXT_PUBLIC_AUTH_DISABLED
# is "true". Auth-protection specs need real Clerk gating, so leave this unset
# unless you are deliberately testing bypass-on behavior.
# E2E_ALLOW_AUTH_DISABLED=true
